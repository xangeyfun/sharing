# Required
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SECRET_KEY=
DISCORD_WEBHOOK_URL=

# Site
BASE_URL=https://share.xangey.dev
SECURE_COOKIES=1

# Storage and data
DATABASE_PATH=data/share.db
STORAGE_PATH=data/files
FILE_RETENTION_DAYS=7

# Limits and sessions
MAX_UPLOAD_SIZE=10737418240
SESSION_LIFETIME=3600

# Maintenance
CLEANUP_INTERVAL=3600

# Generate values with these commands:
#   SECRET_KEY:           python -c "import secrets; print(secrets.token_hex(32))"
#   ADMIN_PASSWORD_HASH:  python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('your-password'))"
#
# Set SECURE_COOKIES=0 only for local development over plain HTTP.
# DATABASE_PATH and STORAGE_PATH must NOT live under a publicly served directory.